{
  "name": "mdldm-knowledge-kit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:l1": "vitest run --config vitest.l1.config.ts",
    "test:l2": "vitest run --config vitest.l2.config.ts",
    "test:l3": "vitest run --config vitest.l3.config.ts",
    "test:layers": "node scripts/run-test-layers.mjs",
    "test:watch": "vitest",
    "test:l4:auto": "playwright test --config playwright.config.ts",
    "test:l4:manual": "playwright test --config playwright.manual.config.ts",
    "test:l4": "node scripts/run-test-l4.mjs",
    "test:e2e": "pnpm test:l4",
    "check": "node scripts/check.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "quickstart:prepare": "tsx scripts/prepare-local-env.ts",
    "agent:status": "tsx scripts/agent-status.ts",
    "doctor": "tsx scripts/doctor.ts",
    "check-config": "tsx scripts/check-config.ts",
    "check:serverless": "tsx scripts/check-serverless-readiness.ts",
    "validate:providers": "tsx scripts/validate-provider-config.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-invitation": "tsx scripts/create-invitation.ts",
    "sync-products": "tsx scripts/sync-products.ts",
    "seed-demo": "tsx scripts/run-seed-demo.ts"
  },
  "dependencies": {
    "@next/env": "15.5.21",
    "ali-oss": "^6.23.0",
    "bcryptjs": "3.0.3",
    "geist": "1.7.2",
    "mongoose": "8.24.1",
    "next": "15.5.21",
    "nodemailer": "^9.0.3",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.14.0"
  }
}
