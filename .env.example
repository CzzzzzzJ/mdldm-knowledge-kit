# 1. 最低核心：启动站点只需要确认这四项
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/mdldm_knowledge_kit
# 本地运行 pnpm quickstart:prepare 会安全生成，不会在终端打印真实值。
AUTH_SECRET=replace-with-a-long-random-value
# 公开部署首次访问 /admin 时使用；本地准备命令会把占位值清空。
INITIAL_SETUP_TOKEN=replace-with-one-time-setup-token

# 2. 安全默认值：不接第三方平台也能运行
APP_NAME=mdldm Knowledge Kit
NODE_ENV=development
SESSION_COOKIE_NAME=mdldm_session
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
MAX_UPLOAD_BYTES=536870912

# 不启用视频和资料时无需 OSS；Local 只适合本地或有持久磁盘的单机部署。
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# Console 只在开发环境输出验证链接；生产环境会停用依赖真实邮件的自助入口。
EMAIL_PROVIDER=console

# Manual 是默认可运营支付方式，不依赖自动支付平台。
PAYMENT_PROVIDER=manual
MANUAL_PAYMENT_INSTRUCTIONS=请按站点说明完成转账，管理员核对后会确认订单。

# 第一版明确不启用转码；上传前准备可直接播放的媒体文件。
TRANSCODE_PROVIDER=none

# Console 保留结构化日志和后台失败队列，但不主动发送外部告警。
OBSERVABILITY_PROVIDER=console

# 3. 按需能力：只有选择对应 Provider 时才校验下面的变量

# 视频与资料 / 阿里云 OSS：把 STORAGE_PROVIDER 改为 oss 后启用。
OSS_REGION=
OSS_BUCKET=
# 可选；留空时由 ali-oss 根据 Region 选择地址。
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选临时 STS 凭据。
OSS_SESSION_TOKEN=

# 真实验证与找回邮件 / SMTP：把 EMAIL_PROVIDER 改为 smtp 后启用。
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# 自动支付 / XorPay：把 PAYMENT_PROVIDER 改为 xorpay 后启用。
XORPAY_AID=
XORPAY_APP_SECRET=
# 可选；留空时使用 APP_URL/api/payments/webhooks/xorpay。
XORPAY_NOTIFY_URL=

# 外部故障通知 / 签名 Webhook：把 OBSERVABILITY_PROVIDER 改为 webhook 后启用。
OBSERVABILITY_WEBHOOK_URL=
# 至少 16 个字符。
OBSERVABILITY_WEBHOOK_SECRET=

# 4. 功能开关
FEATURE_MEMBERSHIP=true
FEATURE_SINGLE_COURSE=true
FEATURE_COMMENTS=false
FEATURE_ASSIGNMENTS=false

# 5. 公共第一版不接受的配置值
# STORAGE_PROVIDER=s3、TRANSCODE_PROVIDER=ffmpeg/aliyun-mps、
# OBSERVABILITY_PROVIDER=sentry 均不会被静默降级；对应扩展路线另行记录。
