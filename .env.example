# Application
APP_URL=http://localhost:3000
APP_NAME=mdldm Knowledge Kit
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/mdldm_knowledge_kit

# Authentication
# Generate locally. Never commit a real value.
AUTH_SECRET=replace-with-a-long-random-value

# Providers: local | s3 | oss
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# Providers: console | smtp
EMAIL_PROVIDER=console

# Providers: manual | mock | xorpay
PAYMENT_PROVIDER=mock

# Providers: none | ffmpeg | aliyun-mps
TRANSCODE_PROVIDER=none

# Providers: console | webhook | sentry
OBSERVABILITY_PROVIDER=console

# Feature flags: true | false
FEATURE_MEMBERSHIP=true
FEATURE_SINGLE_COURSE=true
FEATURE_COMMENTS=false
FEATURE_ASSIGNMENTS=false
