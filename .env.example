# Application
APP_URL=http://localhost:3000
APP_NAME=mdldm Knowledge Kit
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/mdldm_knowledge_kit

# Authentication
# Generate locally. Never commit a real value.
AUTH_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_NAME=mdldm_session
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
MAX_UPLOAD_BYTES=536870912

# Providers: local | s3 | oss
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
# Required only when STORAGE_PROVIDER=oss.
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional temporary STS credential.
OSS_SESSION_TOKEN=

# Providers: console | smtp
EMAIL_PROVIDER=console
# Required only when EMAIL_PROVIDER=smtp.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Providers: manual | mock | xorpay
PAYMENT_PROVIDER=mock
# Shown to buyers when PAYMENT_PROVIDER=manual.
MANUAL_PAYMENT_INSTRUCTIONS=请按站点说明完成转账，管理员核对后会确认订单。
# Required only when PAYMENT_PROVIDER=xorpay.
XORPAY_AID=
XORPAY_APP_SECRET=
# Optional. Defaults to APP_URL/api/payments/webhooks/xorpay.
XORPAY_NOTIFY_URL=

# Providers: none | ffmpeg | aliyun-mps
TRANSCODE_PROVIDER=none

# Providers: console | webhook | sentry
OBSERVABILITY_PROVIDER=console
# Required only when OBSERVABILITY_PROVIDER=webhook.
OBSERVABILITY_WEBHOOK_URL=
# Shared signing secret, at least 16 characters.
OBSERVABILITY_WEBHOOK_SECRET=

# Feature flags: true | false
FEATURE_MEMBERSHIP=true
FEATURE_SINGLE_COURSE=true
FEATURE_COMMENTS=false
FEATURE_ASSIGNMENTS=false
